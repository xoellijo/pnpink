<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <_name>DeckMaker Web v0.74.0-beta.1</_name>
  <id>pnpink.deckmaker_web</id>
  <effect needs-live-preview="false" implements-custom-gui="true">
    <object-type>all</object-type>
    <effects-menu>
      <submenu _name="PnPInk"/>
    </effects-menu>
    <menu-tip>Open DeckMaker in the browser for the current SVG template.</menu-tip>
  </effect>
  <script>
    <command reldir="extensions" interpreter="python">pnpink/deckmaker_web_launcher.py</command>
  </script>
</inkscape-extension>
