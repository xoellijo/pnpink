<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">

  <_name>DeckMaker v0.44</_name>
  <id>pnpink.deckmaker</id>

  <param name="tab" type="notebook">
    <page name="data" gui-text="Data">
      <param name="sheet_id" type="string" gui-text="GSheet ID" appearance="full"/>
      <label>If empty: load &lt;svg_name&gt;.csv from the same folder.</label>

      <param name="sheet_range" type="string" gui-text="Sheet!range/gid" appearance="full"/>
      <label>Public access: numeric gid (empty = gid 0).</label>
      <label>OAuth/private: if empty, try sheet = SVG name, else first sheet.</label>
    </page>

    <page name="about" gui-text="About">
      <label>DeckMaker builds cards from the current SVG template and a dataset.</label>
      <label>Flow:</label>
      <label>1) Empty GSheet ID: use &lt;svg_name&gt;.csv in the same folder.</label>
      <label>2) With GSheet ID: try public access first, then OAuth fallback.</label>
      <label>3) Selector supports Sheet!range or numeric gid.</label>
      <label>4) Empty selector: public uses gid 0; OAuth uses SVG-name sheet or first sheet.</label>
    </page>
  </param>

  <effect needs-live-preview="false">
    <object-type>all</object-type>
    <effects-menu>
      <submenu _name="PnPInk"/>
    </effects-menu>
    <menu-tip>Build a deck from current document + CSV/google sheets.</menu-tip>
  </effect>

  <script>
    <command reldir="extensions" interpreter="python">pnpink/deckmaker.py</command>
  </script>

</inkscape-extension>
